{
  "name": "My Linux Desktop",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/desktop-lite:1": {}
  },
  "runArgs": ["--shm-size=1g"],
  "remoteUser": "vscode",
  "postStartCommand": "/workspaces/my-linux-desktop-demo/start-desktop.sh",
  "forwardPorts": [6080],
  "portsAttributes": {
    "6080": {
      "label": "Linux Desktop",
      "visibility": "public"
    }
  }
}
